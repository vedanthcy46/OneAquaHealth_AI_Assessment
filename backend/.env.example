# ─── Server ───────────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://aquaguard:password@localhost:5432/aquaguard

# ─── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=change-this-to-a-very-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# ─── Object Storage (Cloudflare R2 / AWS S3 compatible) ──
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=aquaguard-media
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=auto

# ─── AI Providers ─────────────────────────────────────
AI_PROVIDER=gemini            # gemini | openai
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# ─── Frontend URL (CORS) ──────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
